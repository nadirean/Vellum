{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "paths": {
      "@components/*": ["./app/components/*"],
      "@consts/*": ["./app/consts/*"],
      "@providers/*": ["./app/providers/*"],
      "@router/*": ["./app/router/*"],
      "@screens/*": ["./app/screens/*"],
      "@stores/*": ["./app/stores/*"],
      "@type/*": ["./app/types/*"],
      "@utils/*": ["./app/utils/*"]
    },
    "jsx": "react",
    "moduleResolution": "bundler",
    "strict": true
  }
}
