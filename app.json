{
  "expo": {
    "name": "Vellum",
    "slug": "vellum",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "vellum",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.f4rys.vellum",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D12"
      },
      "package": "com.vellum"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D12",
          "image": "./assets/splash-icon.png"
        }
      ]
    ]
  }
}
