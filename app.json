{
  "expo": {
    "name": "Vellum",
    "slug": "vellum",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vellum",
    "platforms": [
      "android"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android_icon_foreground.png",
        "backgroundImage": "./assets/android_icon_background.png",
        "monochromeImage": "./assets/android_icon_monochrome.png"
      },
      "package": "com.nadirean.vellum"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/android_icon_foreground.png"
        }
      ],
      "expo-audio",
      "expo-font",
      [
        "expo-media-control",
        {
          "notificationIcon": "./assets/android_notification.png"
        }
      ]
    ]
  }
}
